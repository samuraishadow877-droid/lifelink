/* =========================================================
   LOAD MAPLIBRE
   ========================================================= */

function loadMapLibre() {

    return new Promise(function (resolve, reject) {

        if (window.maplibregl) {

            resolve();

            return;

        }


        const existingScript =
            document.querySelector(
                'script[data-lifelink-maplibre="js"]'
            );


        if (existingScript) {

            existingScript.addEventListener(
                "load",
                function () {

                    if (window.maplibregl) {
                        resolve();
                    } else {
                        reject(
                            new Error(
                                "MapLibre did not initialize."
                            )
                        );
                    }

                }
            );


            existingScript.addEventListener(
                "error",
                function () {

                    reject(
                        new Error(
                            "MapLibre script failed."
                        )
                    );

                }
            );


            return;

        }


        const css =
            document.createElement("link");

        css.rel = "stylesheet";

        css.href =
            "https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.css";

        css.dataset.lifelinkMaplibre =
            "css";

        document.head.appendChild(css);


        const script =
            document.createElement("script");

        script.src =
            "https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.js";

        script.dataset.lifelinkMaplibre =
            "js";

        script.async = true;


        script.onload = function () {

            if (window.maplibregl) {

                resolve();

            } else {

                reject(
                    new Error(
                        "MapLibre loaded but global object is missing."
                    )
                );

            }

        };


        script.onerror = function () {

            reject(
                new Error(
                    "Could not download MapLibre GL JS."
                )
            );

        };


        document.head.appendChild(script);

    });

}


