/* =========================================================
   POPUP
   ========================================================= */

function createMapPopup(resource) {

    const wrapper =
        document.createElement("div");

    wrapper.className =
        "map-popup";


    const category =
        document.createElement("div");

    category.className =
        "map-popup-category";

    category.textContent =
        resource.icon +
        " " +
        resource.category;


    const title =
        document.createElement("div");

    title.className =
        "map-popup-title";

    title.textContent =
        resource.name;


    const location =
        document.createElement("p");

    location.className =
        "map-popup-text";

    location.textContent =
        "📍 " +
        resource.location;


    const service =
        document.createElement("p");

    service.className =
        "map-popup-text";

    service.textContent =
        "🛠️ " +
        resource.service;


    const note =
        document.createElement("p");

    note.className =
        "map-popup-text";

    note.textContent =
        "ℹ️ Demonstration resource location";


    wrapper.appendChild(category);
    wrapper.appendChild(title);
    wrapper.appendChild(location);
    wrapper.appendChild(service);
    wrapper.appendChild(note);


    return wrapper;

}


/* =========================================================
   MARKERS
   ========================================================= */

function createMapMarkers(map) {

    LIFELINK.mapMarkers = [];


    MAP_RESOURCES.forEach(function (resource) {

        const element =
            document.createElement("button");

        element.type =
            "button";

        element.className =
            "lifelink-marker";

        element.textContent =
            resource.icon;

        element.title =
            resource.name;

        element.setAttribute(
            "aria-label",
            resource.name
        );


        const popup =
            new maplibregl.Popup({
                offset: 25,
                closeButton: true
            })
            .setDOMContent(
                createMapPopup(resource)
            );


        const marker =
            new maplibregl.Marker({
                element: element,
                anchor: "center"
            })
            .setLngLat([
                resource.longitude,
                resource.latitude
            ])
            .setPopup(popup)
            .addTo(map);


        LIFELINK.mapMarkers.push({

            resource: resource,

            marker: marker,

            element: element

        });

    });

}


/* =========================================================
   FILTER MAP
   ========================================================= */

function applyMapFilter(category) {

    LIFELINK.activeMapFilter =
        category;


    let visible = 0;


    LIFELINK.mapMarkers.forEach(function (item) {

        const show =
            category === "all" ||
            item.resource.category === category;


        item.element.style.display =
            show ? "grid" : "none";


        if (show) {
            visible++;
        }

    });


    if (category === "all") {

        setMapStatus(
            "🟢 Map ready — showing all " +
            visible +
            " demonstration resources."
        );

    } else {

        setMapStatus(
            "📍 Showing " +
            visible +
            " " +
            category +
            " resource" +
            (visible === 1 ? "" : "s") +
            "."
        );

    }

}


/* =========================================================
   MAP FILTER BUTTONS
   ========================================================= */

function initializeMapFilters() {

    const buttons =
        document.querySelectorAll(".map-filter");


    buttons.forEach(function (button) {

        button.addEventListener("click", function () {

            buttons.forEach(function (item) {

                item.classList.remove("active");

            });


            this.classList.add("active");


            applyMapFilter(
                this.dataset.mapFilter || "all"
            );

        });

    });

}


/* =========================================================
   MAP SEARCH
   ========================================================= */

function initializeMapSearch(map) {

    const input =
        document.getElementById("mapSearch");

    const button =
        document.getElementById("mapSearchButton");


    if (!input || !button) {
        return;
    }


    let searchMarker =
        null;


    async function performSearch() {

        const query =
            input.value.trim();


        if (!query) {

            setMapStatus(
                "🔎 Enter a place to search."
            );

            return;

        }


        setMapStatus(
            "🔎 Searching for " +
            query +
            "..."
        );


        try {

            const url =
                "https://nominatim.openstreetmap.org/search" +
                "?format=jsonv2" +
                "&limit=1" +
                "&q=" +
                encodeURIComponent(query);


            const response =
                await fetch(url, {
                    headers: {
                        Accept:
                            "application/json"
                    }
                });


            if (!response.ok) {

                throw new Error(
                    "Search request failed."
                );

            }


            const results =
                await response.json();


            if (!Array.isArray(results) ||
                results.length === 0) {

                setMapStatus(
                    "❌ No matching place found."
                );

                return;

            }


            const result =
                results[0];


            const longitude =
                Number(result.lon);

            const latitude =
                Number(result.lat);


            if (
                !Number.isFinite(longitude) ||
                !Number.isFinite(latitude)
            ) {

                throw new Error(
                    "Search returned invalid coordinates."
                );

            }


            map.flyTo({

                center: [
                    longitude,
                    latitude
                ],

                zoom: 14,

                speed: 1.2,

                essential: true

            });


            if (searchMarker) {

                searchMarker.remove();

            }


            searchMarker =
                new maplibregl.Marker({
                    color: "#5c8dff"
                })
                .setLngLat([
                    longitude,
                    latitude
                ])
                .setPopup(
                    new maplibregl.Popup({
                        offset: 25
                    })
                    .setText(
                        "📍 " +
                        result.display_name
                    )
                )
                .addTo(map);


            searchMarker.togglePopup();


            setMapStatus(
                "📍 Showing: " +
                result.display_name
            );


        } catch (error) {

            console.error(
                "LIFELINK map search error:",
                error
            );


            setMapStatus(
                "⚠️ Search could not be completed."
            );

        }

    }


    button.addEventListener(
        "click",
        performSearch
    );


    input.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Enter") {

                event.preventDefault();

                performSearch();

            }

        }
    );

}


/* =========================================================
   USER LOCATION
   ========================================================= */

function initializeLocation(map) {

    const button =
        document.getElementById("myLocationButton");


    if (!button) {
        return;
    }


    button.addEventListener("click", function () {

        if (!navigator.geolocation) {

            setMapStatus(
                "❌ Geolocation is not supported by this browser."
            );

            return;

        }


        setMapStatus(
            "📍 Requesting your location..."
        );


        navigator.geolocation.getCurrentPosition(

            function (position) {

                const latitude =
                    position.coords.latitude;

                const longitude =
                    position.coords.longitude;


                if (
                    !Number.isFinite(latitude) ||
                    !Number.isFinite(longitude)
                ) {

                    setMapStatus(
                        "⚠️ Your browser returned invalid coordinates."
                    );

                    return;

                }


                map.flyTo({

                    center: [
                        longitude,
                        latitude
                    ],

                    zoom: 15,

                    speed: 1.2,

                    essential: true

                });


                if (LIFELINK.userMarker) {

                    LIFELINK.userMarker.remove();

                }


                const element =
                    document.createElement("div");

                element.style.width =
                    "22px";

                element.style.height =
                    "22px";

                element.style.borderRadius =
                    "50%";

                element.style.background =
                    "#5c8dff";

                element.style.border =
                    "4px solid white";

                element.style.boxShadow =
                    "0 0 0 7px rgba(92,141,255,.25), 0 5px 20px rgba(0,0,0,.5)";


                LIFELINK.userMarker =
                    new maplibregl.Marker({
                        element: element
                    })
                    .setLngLat([
                        longitude,
                        latitude
                    ])
                    .setPopup(
                        new maplibregl.Popup({
                            offset: 18
                        })
                        .setText(
                            "📍 Your current location"
                        )
                    )
                    .addTo(map);


                LIFELINK.userMarker.togglePopup();


                setMapStatus(
                    "📍 Your location is shown on the map."
                );

            },


            function (error) {

                console.warn(
                    "LIFELINK geolocation error:",
                    error
                );


                if (
                    error.code ===
                    error.PERMISSION_DENIED
                ) {

                    setMapStatus(
                        "⚠️ Location permission was denied."
                    );

                } else if (
                    error.code ===
                    error.TIMEOUT
                ) {

                    setMapStatus(
                        "⚠️ Location request timed out."
                    );

                } else {

                    setMapStatus(
                        "⚠️ Unable to determine your location."
                    );

                }

            },


            {

                enableHighAccuracy: true,

                timeout: 10000,

                maximumAge: 60000

            }

        );

    });

}


/* =========================================================
   MAP INITIALIZATION
   ========================================================= */

function initializeMap() {

    const container =
        document.getElementById("lifelinkMap");

    const loading =
        document.getElementById("mapLoading");


    if (!container) {

        console.warn(
            "LIFELINK V3.1: map container not found."
        );

        return;

    }


    /*
       We deliberately use a simple raster map here.

       Why?

       - No Mapbox token.
       - No Mapbox billing.
       - No vector sprite dependency.
       - No Leaflet.
       - No style JSON sprite errors.
       - MapLibre still handles navigation,
         markers, popups and controls.
    */

    loadMapLibre()

        .then(function () {

            const map =
                new maplibregl.Map({

                    container:
                        "lifelinkMap",

                    center: [
                        72.8777,
                        19.0760
                    ],

                    zoom: 11,

                    attributionControl: true,

                    style: {

                        version: 8,

                        sources: {

                            "osm-raster": {

                                type: "raster",

                                tiles: [
                                    "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                                ],

                                tileSize: 256,

                                attribution:
                                    "© OpenStreetMap contributors"

                            }

                        },

                        layers: [

                            {

                                id: "osm-raster-layer",

                                type: "raster",

                                source: "osm-raster",

                                minzoom: 0,

                                maxzoom: 19

                            }

                        ]

                    }

                });


            LIFELINK.map =
                map;


            map.addControl(
                new maplibregl.NavigationControl({
                    showCompass: true,
                    showZoom: true
                }),
                "top-right"
            );


            map.addControl(
                new maplibregl.FullscreenControl(),
                "top-right"
            );


            map.on("load", function () {

                LIFELINK.mapReady =
                    true;


                createMapMarkers(map);

                initializeMapFilters();

                initializeMapSearch(map);

                initializeLocation(map);

                applyMapFilter("all");


                if (loading) {

                    loading.classList.add(
                        "loaded"
                    );

                }


                setTimeout(function () {

                    map.resize();

                }, 100);


                console.log(
                    "LIFELINK V3.1 map initialized successfully."
                );

            });


            map.on("error", function (event) {

                console.warn(
                    "LIFELINK V3.1 map event:",
                    event
                );

                setMapStatus(
                    "⚠️ Some map tiles could not be loaded."
                );

            });


            window.addEventListener(
                "resize",
                function () {

                    if (LIFELINK.map) {

                        LIFELINK.map.resize();

                    }

                }
            );

        })


        .catch(function (error) {

            console.error(
                "LIFELINK V3.1 map initialization failed:",
                error
            );


            if (loading) {

                loading.classList.add(
                    "loaded"
                );

            }


            setMapStatus(
                "⚠️ Map could not be loaded. The rest of LIFELINK is still available."
            );

        });

}


