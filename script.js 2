"use strict";


/* =========================================================
   GLOBAL APP
   ========================================================= */

const LIFELINK = {

    map: null,

    mapMarkers: [],

    userMarker: null,

    activeMapFilter: "all",

    activeResourceFilter: "all",

    mapReady: false

};


/* =========================================================
   DOM READY
   ========================================================= */

document.addEventListener("DOMContentLoaded", function () {

    console.log("LIFELINK V3.1 starting...");

    initializeNavigation();

    initializeEmergencyActions();

    initializeChecklist();

    initializeResources();

    initializeSafetyHelper();

    initializeMap();

});


/* =========================================================
   NAVIGATION
   ========================================================= */

function initializeNavigation() {

    const menuButton =
        document.getElementById("mobileMenuButton");

    const navigation =
        document.getElementById("mainNavigation");


    if (!menuButton || !navigation) {
        return;
    }


    menuButton.addEventListener("click", function () {

        const isOpen =
            navigation.classList.toggle("open");

        menuButton.setAttribute(
            "aria-expanded",
            String(isOpen)
        );

    });


    navigation.querySelectorAll("a").forEach(function (link) {

        link.addEventListener("click", function () {

            navigation.classList.remove("open");

            menuButton.setAttribute(
                "aria-expanded",
                "false"
            );

        });

    });

}


/* =========================================================
   EMERGENCY ACTIONS
   ========================================================= */

function initializeEmergencyActions() {

    document
        .querySelectorAll("[data-emergency]")
        .forEach(function (button) {

            button.addEventListener("click", function () {

                const number =
                    this.dataset.emergency;

                if (!number) {
                    return;
                }

                window.location.href =
                    "tel:" + number;

            });

        });

}


/* =========================================================
   CHECKLIST
   ========================================================= */

function initializeChecklist() {

    const checks =
        document.querySelectorAll(".emergency-check");

    const progress =
        document.getElementById("checklistProgress");


    if (!checks.length || !progress) {
        return;
    }


    function updateProgress() {

        let completed = 0;

        checks.forEach(function (check) {

            if (check.checked) {
                completed++;
            }

        });


        progress.textContent =
            completed +
            " of " +
            checks.length +
            " completed";

    }


    checks.forEach(function (check) {

        check.addEventListener(
            "change",
            updateProgress
        );

    });

}


/* =========================================================
   RESOURCES
   ========================================================= */

function initializeResources() {

    const search =
        document.getElementById("resourceSearch");

    const cards =
        Array.from(
            document.querySelectorAll(".resource-card")
        );

    const filters =
        document.querySelectorAll(".resource-filter");

    const count =
        document.getElementById("resourceCount");


    if (!cards.length) {
        return;
    }


    function updateResources() {

        const query =
            search
                ? search.value
                    .trim()
                    .toLowerCase()
                : "";


        let visible = 0;


        cards.forEach(function (card) {

            const category =
                card.dataset.category || "";

            const searchable =
                card.dataset.search || "";


            const categoryMatches =
                LIFELINK.activeResourceFilter === "all" ||
                category === LIFELINK.activeResourceFilter;


            const searchMatches =
                !query ||
                searchable.toLowerCase().includes(query);


            const shouldShow =
                categoryMatches &&
                searchMatches;


            card.classList.toggle(
                "hidden",
                !shouldShow
            );


            if (shouldShow) {
                visible++;
            }

        });


        if (count) {

            count.textContent =
                "Showing " +
                visible +
                " resource" +
                (visible === 1 ? "" : "s");

        }

    }


    filters.forEach(function (button) {

        button.addEventListener("click", function () {

            filters.forEach(function (item) {

                item.classList.remove("active");

            });


            this.classList.add("active");


            LIFELINK.activeResourceFilter =
                this.dataset.category ||
                "all";


            updateResources();

        });

    });


    if (search) {

        search.addEventListener(
            "input",
            updateResources
        );

    }


    document
        .querySelectorAll(".resource-details")
        .forEach(function (button) {

            button.addEventListener("click", function () {

                const name =
                    this.dataset.name || "Resource";

                const category =
                    this.dataset.category || "Resource";

                const location =
                    this.dataset.location || "—";

                const phone =
                    this.dataset.phone || "—";

                const services =
                    this.dataset.services || "—";


                window.alert(
                    name +
                    "\n\n" +
                    "Category: " +
                    category +
                    "\n" +
                    "Location: " +
                    location +
                    "\n" +
                    "Phone: " +
                    phone +
                    "\n" +
                    "Services: " +
                    services
                );

            });

        });


    updateResources();

}


