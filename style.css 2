/* =========================================================
   LIFELINK V3.1
   COMPLETE UI SYSTEM
   ========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

:root {
    --bg: #05070b;
    --surface: #0b1119;
    --surface-2: #101823;
    --surface-3: #141e2b;

    --border: rgba(255,255,255,0.09);
    --border-strong: rgba(255,255,255,0.15);

    --text: #f4f7fb;
    --muted: #8e9bad;
    --muted-2: #647083;

    --accent: #5c8dff;
    --accent-2: #79a4ff;

    --danger: #ff5d70;
    --success: #54d68a;

    --radius: 18px;
    --radius-small: 12px;

    --shadow:
        0 20px 60px rgba(0,0,0,0.35);

    --max-width: 1180px;
}

body {
    margin: 0;
    min-height: 100vh;

    background:
        radial-gradient(
            circle at 15% 0%,
            rgba(70,110,255,0.08),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 20%,
            rgba(0,180,255,0.05),
            transparent 25%
        ),
        var(--bg);

    color: var(--text);

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(5,7,11,0.82);
    backdrop-filter: blur(18px);

    border-bottom: 1px solid var(--border);
}

.header-inner {
    width: min(var(--max-width), calc(100% - 32px));
    min-height: 72px;

    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-weight: 900;
    letter-spacing: 0.08em;
}

.logo-mark {
    color: var(--accent-2);
    font-size: 22px;
}

.navigation {
    display: flex;
    align-items: center;
    gap: 8px;
}

.navigation a {
    padding: 9px 13px;

    color: var(--muted);

    border-radius: 10px;

    font-size: 14px;
    font-weight: 700;

    transition:
        color .2s ease,
        background .2s ease;
}

.navigation a:hover {
    color: var(--text);
    background: rgba(255,255,255,0.06);
}

.mobile-menu-button {
    display: none;

    border: 1px solid var(--border);
    background: var(--surface);

    color: var(--text);

    padding: 9px 12px;
    border-radius: 10px;
}

.hero {
    position: relative;
    overflow: hidden;

    min-height: 680px;

    display: grid;
    place-items: center;

    border-bottom: 1px solid var(--border);
}

.hero-content {
    position: relative;
    z-index: 2;

    width: min(900px, calc(100% - 32px));

    text-align: center;
}

.hero-badge,
.section-label,
.card-label {
    color: var(--accent-2);

    font-size: 11px;
    font-weight: 900;

    letter-spacing: .13em;
}

.hero h1 {
    margin: 22px 0 18px;

    font-size:
        clamp(48px, 8vw, 94px);

    line-height: .98;
    letter-spacing: -.055em;
}

.hero h1 span {
    display: block;

    background:
        linear-gradient(
            90deg,
            #ffffff,
            var(--accent-2)
        );

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.hero-description {
    max-width: 650px;

    margin: auto;

    color: var(--muted);

    font-size: 18px;
}

.hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;

    margin-top: 32px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 48px;
    padding: 0 20px;

    border: 1px solid var(--border-strong);
    border-radius: 12px;

    font-weight: 800;

    transition:
        transform .2s ease,
        background .2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
}

.btn-secondary {
    background: rgba(255,255,255,0.04);
}

.hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    max-width: 600px;
    margin: 60px auto 0;

    border: 1px solid var(--border);
    border-radius: 18px;

    overflow: hidden;

    background: rgba(10,15,23,.65);
}

.hero-stat {
    padding: 20px;

    border-right: 1px solid var(--border);
}

.hero-stat:last-child {
    border-right: 0;
}

.hero-stat strong {
    display: block;
    font-size: 25px;
}

.hero-stat span {
    color: var(--muted);
    font-size: 12px;
}

.hero-orb {
    position: absolute;

    width: 420px;
    height: 420px;

    border-radius: 50%;

    filter: blur(100px);

    opacity: .12;
}

.hero-orb-one {
    background: #4f7cff;

    left: -180px;
    top: 120px;
}

.hero-orb-two {
    background: #00b7ff;

    right: -180px;
    bottom: 40px;
}

.section {
    width: min(var(--max-width), calc(100% - 32px));

    margin: auto;
    padding: 100px 0;
}

.section-heading {
    max-width: 720px;
    margin-bottom: 38px;
}

.section-heading h2,
.about-content h2 {
    margin: 8px 0 12px;

    font-size: clamp(34px, 5vw, 54px);

    line-height: 1.05;
    letter-spacing: -.04em;
}

.section-heading p,
.about-content p {
    color: var(--muted);
}

.emergency-alert {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: center;

    padding: 22px;

    border: 1px solid rgba(255,93,112,.2);
    border-radius: var(--radius);

    background:
        linear-gradient(
            120deg,
            rgba(255,93,112,.08),
            rgba(255,255,255,.02)
        );
}

.alert-icon {
    font-size: 30px;
}

.alert-content strong {
    font-size: 17px;
}

.alert-content p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 14px;
}

.alert-button {
    padding: 11px 18px;

    background: var(--danger);
    border-radius: 10px;

    color: white;
    font-weight: 900;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;

    margin-top: 18px;
}

.quick-action {
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 17px;

    border: 1px solid var(--border);
    border-radius: var(--radius-small);

    background: var(--surface);

    color: var(--text);

    text-align: left;

    transition:
        transform .2s ease,
        border .2s ease;
}

.quick-action:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
}

.quick-action-icon {
    font-size: 25px;
}

.quick-action strong,
.quick-action small {
    display: block;
}

.quick-action small {
    color: var(--muted);
}

.emergency-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;

    margin-top: 18px;
}

.glass-card,
.trusted-contact,
.safety-helper {
    border: 1px solid var(--border);
    border-radius: var(--radius);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.035),
            rgba(255,255,255,.012)
        );

    box-shadow: var(--shadow);
}

.glass-card {
    padding: 25px;
}

.tool-header {
    display: flex;
    gap: 14px;
    align-items: center;
}

.tool-icon {
    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: rgba(92,141,255,.1);

    font-size: 20px;
}

.tool-header h3 {
    margin: 2px 0 0;
}

.checklist {
    display: grid;
    gap: 12px;

    margin-top: 22px;
}

.check-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    color: var(--muted);

    font-size: 14px;
}

.check-item input {
    margin-top: 5px;
    accent-color: var(--accent);
}

.checklist-progress {
    margin-top: 18px;

    color: var(--accent-2);

    font-size: 13px;
    font-weight: 800;
}

.tool-description,
.location-status {
    color: var(--muted);
    font-size: 14px;
}

.tool-button {
    display: inline-flex;

    margin-top: 12px;
    padding: 12px 16px;

    border: 1px solid var(--border);
    border-radius: 10px;

    background: rgba(255,255,255,.04);

    font-weight: 800;
}

.trusted-contact {
    margin-top: 18px;
    padding: 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.trusted-contact h3 {
    margin: 6px 0;
}

.trusted-contact p {
    margin: 0;
    color: var(--muted);
}

.resource-search-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 0 16px;

    min-height: 54px;

    border: 1px solid var(--border);
    border-radius: 14px;

    background: var(--surface);
}

.resource-search-wrapper input {
    width: 100%;

    border: 0;
    outline: 0;

    background: transparent;

    color: var(--text);
}

.resource-filters,
.map-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    margin-top: 16px;
}

.resource-filter,
.map-filter {
    padding: 8px 13px;

    border: 1px solid var(--border);
    border-radius: 999px;

    background: var(--surface);

    color: var(--muted);

    font-size: 12px;
    font-weight: 800;
}

.resource-filter.active,
.map-filter.active {
    background: rgba(92,141,255,.15);
    border-color: rgba(92,141,255,.45);
    color: white;
}

.resource-toolbar {
    display: flex;
    justify-content: space-between;

    margin: 22px 0 14px;

    color: var(--muted);

    font-size: 12px;
}

.resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.resource-card {
    padding: 21px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: var(--surface);

    transition:
        transform .2s ease,
        border .2s ease;
}

.resource-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
}

.resource-card.hidden {
    display: none;
}

.resource-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.resource-card-icon {
    font-size: 30px;
}

.resource-status {
    color: var(--success);

    font-size: 11px;
    font-weight: 800;
}

.resource-tag {
    display: inline-block;

    margin-top: 16px;

    color: var(--accent-2);

    font-size: 10px;
    font-weight: 900;
    letter-spacing: .12em;
}

.resource-card h3 {
    margin: 8px 0;
}

.resource-card p {
    color: var(--muted);
    font-size: 14px;
}

.resource-info {
    display: grid;
    gap: 5px;

    color: var(--muted-2);

    font-size: 12px;
}

.resource-actions {
    display: flex;
    gap: 8px;

    margin-top: 18px;
}

.resource-call,
.resource-details {
    flex: 1;

    min-height: 40px;

    display: grid;
    place-items: center;

    border: 1px solid var(--border);
    border-radius: 9px;

    background: rgba(255,255,255,.04);

    color: var(--text);

    font-size: 12px;
    font-weight: 800;
}

.resource-call {
    background: rgba(92,141,255,.12);
}


/* =========================================================
   V3.1 MAP
   ========================================================= */

.map-section {
    padding-top: 60px;
}

.map-shell {
    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 20px;

    background: #080d14;

    box-shadow: var(--shadow);
}

.map-toolbar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;

    padding: 14px;
}

.map-search {
    display: flex;
    align-items: center;
    gap: 10px;

    min-height: 48px;

    padding-left: 14px;

    border: 1px solid var(--border);
    border-radius: 11px;

    background: #0b1119;
}

.map-search input {
    flex: 1;

    min-width: 0;

    border: 0;
    outline: 0;

    background: transparent;

    color: white;
}

.map-search button,
.location-button {
    min-height: 38px;

    padding: 0 14px;

    border: 1px solid var(--border);
    border-radius: 9px;

    background: #111925;

    color: white;

    font-size: 12px;
    font-weight: 800;
}

.location-button {
    min-height: 48px;
}

.map-filters {
    padding: 0 14px 14px;
}

.map-frame {
    position: relative;

    height: 560px;

    background: #111820;
}

.lifelink-map {
    width: 100%;
    height: 100%;
}

.map-loading {
    position: absolute;
    inset: 0;

    z-index: 5;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;

    background: #0b1119;

    color: var(--muted);

    transition: opacity .3s ease;
}

.map-loading.loaded {
    opacity: 0;
    pointer-events: none;
}

.loading-spinner {
    width: 34px;
    height: 34px;

    border: 3px solid rgba(255,255,255,.12);
    border-top-color: var(--accent);

    border-radius: 50%;

    animation: spin .8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.map-status {
    min-height: 42px;

    display: flex;
    align-items: center;

    padding: 0 15px;

    border-top: 1px solid var(--border);

    color: var(--muted);

    font-size: 12px;
}

.map-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;

    padding: 12px 14px;
}

.map-info-card {
    display: flex;
    gap: 12px;

    padding: 15px;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: rgba(255,255,255,.025);
}

.map-info-card > span {
    font-size: 20px;
}

.map-info-card strong,
.map-info-card small {
    display: block;
}

.map-info-card strong {
    font-size: 13px;
}

.map-info-card small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
}

.map-attribution-note {
    padding: 0 15px 15px;

    color: var(--muted-2);

    font-size: 10px;
}


/* MapLibre popup */

.maplibregl-popup-content {
    padding: 0 !important;

    border-radius: 14px !important;

    overflow: hidden;

    background: #0c131d !important;

    color: white;

    box-shadow: 0 15px 40px rgba(0,0,0,.45) !important;
}

.maplibregl-popup-close-button {
    color: white !important;
    font-size: 18px;
}

.map-popup {
    width: 250px;
    padding: 16px;
}

.map-popup-category {
    color: var(--accent-2);

    font-size: 11px;
    font-weight: 900;

    text-transform: uppercase;
}

.map-popup-title {
    margin-top: 5px;

    font-size: 16px;
    font-weight: 900;
}

.map-popup-text {
    margin: 7px 0 0;

    color: #9aa7b7;

    font-size: 12px;
}


/* Custom marker */

.lifelink-marker {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border: 2px solid rgba(255,255,255,.9);
    border-radius: 50%;

    background: rgba(5,7,11,.94);

    box-shadow:
        0 5px 20px rgba(0,0,0,.5);

    font-size: 20px;

    cursor: pointer;

    transition:
        transform .15s ease;
}

.lifelink-marker:hover {
    transform: scale(1.13);
}


/* =========================================================
   GUIDE
   ========================================================= */

.guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.guide-card {
    position: relative;

    padding: 25px;

    min-height: 250px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: var(--surface);
}

.guide-number {
    position: absolute;
    top: 17px;
    right: 18px;

    color: var(--muted-2);

    font-size: 11px;
    font-weight: 900;
}

.guide-icon {
    font-size: 32px;
}

.guide-card h3 {
    margin-bottom: 7px;
}

.guide-card p {
    color: var(--muted);
    font-size: 14px;
}


/* =========================================================
   SAFETY
   ========================================================= */

.safety-helper {
    padding: 28px;
}

.safety-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;

    margin-top: 24px;
}

.safety-options button {
    padding: 16px;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: var(--surface);

    color: white;

    text-align: left;

    font-weight: 800;

    transition: .2s ease;
}

.safety-options button:hover {
    border-color: rgba(92,141,255,.5);
    background: rgba(92,141,255,.08);
}

.safety-result {
    margin-top: 30px;
    padding-top: 28px;

    border-top: 1px solid var(--border);
}

.safety-result.hidden {
    display: none;
}

.safety-result-icon {
    font-size: 40px;
}

.safety-result h3 {
    font-size: 28px;
}

.safety-result p,
.safety-result li {
    color: var(--muted);
}

.safety-result li {
    margin: 7px 0;
}


/* =========================================================
   ABOUT / FOOTER
   ========================================================= */

.about-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: center;
}

.about-content h2 span {
    color: var(--accent-2);
}

.about-points {
    display: grid;
    gap: 14px;
}

.about-point {
    display: flex;
    gap: 14px;

    padding: 17px;

    border: 1px solid var(--border);
    border-radius: 13px;

    background: var(--surface);
}

.about-point > span {
    color: var(--success);
    font-weight: 900;
}

.about-point p {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.site-footer {
    border-top: 1px solid var(--border);

    background: #030509;
}

.footer-inner {
    width: min(var(--max-width), calc(100% - 32px));

    margin: auto;
    padding: 60px 0;

    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 40px;
}

.footer-logo {
    font-weight: 900;
    letter-spacing: .08em;
}

.footer-inner p {
    color: var(--muted);
    font-size: 13px;
}

.footer-links {
    display: grid;
    gap: 7px;
}

.footer-links a {
    color: var(--muted);
    font-size: 13px;
}

.footer-disclaimer strong {
    color: #f0c674;
}

.footer-bottom {
    padding: 20px;

    border-top: 1px solid var(--border);

    color: var(--muted-2);

    text-align: center;

    font-size: 11px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

    .navigation {
        display: none;

        position: absolute;

        top: 72px;
        left: 16px;
        right: 16px;

        padding: 10px;

        flex-direction: column;
        align-items: stretch;

        background: #0a0f17;

        border: 1px solid var(--border);
        border-radius: 14px;
    }

    .navigation.open {
        display: flex;
    }

    .mobile-menu-button {
        display: block;
    }

    .quick-actions,
    .resource-grid,
    .guide-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .about-layout {
        grid-template-columns: 1fr;
    }

    .footer-inner {
        grid-template-columns: 1fr 1fr;
    }

}

@media (max-width: 650px) {

    .section {
        padding: 70px 0;
    }

    .hero {
        min-height: 600px;
    }

    .hero h1 {
        font-size: 48px;
    }

    .hero-stats {
        grid-template-columns: 1fr;
    }

    .hero-stat {
        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .hero-stat:last-child {
        border-bottom: 0;
    }

    .emergency-alert {
        grid-template-columns: auto 1fr;
    }

    .alert-button {
        grid-column: 1 / -1;
        text-align: center;
    }

    .emergency-tools,
    .resource-grid,
    .guide-grid,
    .safety-options,
    .map-info-grid,
    .footer-inner {
        grid-template-columns: 1fr;
    }

    .trusted-contact {
        flex-direction: column;
        align-items: flex-start;
    }

    .map-toolbar {
        grid-template-columns: 1fr;
    }

    .map-frame {
        height: 480px;
    }

}
